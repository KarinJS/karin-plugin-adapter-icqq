{
  "name": "@karinjs/adapter-icqq",
  "version": "1.8.0",
  "description": "icqq adapter",
  "license": "MIT",
  "author": "karin",
  "homepage": "https://github.com/KarinJS/karin-plugin-adapter-icqq",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KarinJS/karin-plugin-adapter-icqq.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/KarinJS/karin-plugin-adapter-icqq/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist",
    "web"
  ],
  "scripts": {
    "build": "tsc --noEmit && tsdown",
    "typecheck": "tsc --noEmit",
    "pub": "npm publish --access public",
    "sort": "sort-package-json",
    "karin": "karin",
    "dev": "tsx src/app.ts"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/lodash": "^4.17.20",
    "icqq": "npm:@icqqjs/icqq@^1.7.2",
    "neostandard": "^0.12.2",
    "node-karin": "^1.18.0",
    "tsdown": "^0.21.10",
    "tsx": "^4.20.5"
  },
  "peerDependencies": {
    "icqq": ">=0.6.10"
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./icqq": {
      "development": "./src/icqq.ts",
      "default": "./dist/icqq.js"
    }
  },
  "karin": {
    "main": "src/index.ts",
    "web": "dist/web.config.js",
    "ts-web": "src/web.config.ts",
    "ts-apps": [
      "src/apps"
    ],
    "apps": [
      "dist/apps"
    ],
    "include": [
      "src/**/*"
    ]
  }
}