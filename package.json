{
  "name": "karin-plugin-adapter-icqq-workspace",
  "version": "1.7.1",
  "private": true,
  "description": "Workspace for the ICQQ adapter and its account console",
  "type": "module",
  "scripts": {
    "build": "pnpm run build:web && pnpm run build:core",
    "build:web": "pnpm --filter @karinjs/adapter-icqq-web build",
    "build:core": "pnpm --filter @karinjs/adapter-icqq build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint packages/core/src packages/web/src",
    "dev": "pnpm --filter @karinjs/adapter-icqq dev",
    "karin": "pnpm --filter @karinjs/adapter-icqq karin",
    "pub": "pnpm --filter @karinjs/adapter-icqq pub",
    "sort": "sort-package-json packages/core/package.json packages/web/package.json package.json"
  },
  "devDependencies": {
    "eslint": "^9.35.0",
    "neostandard": "^0.12.2",
    "sort-package-json": "^3.4.0",
    "tsdown": "^0.21.10",
    "typescript": "^5.9.2"
  }
}